# Copy to .env for local development.

# Postgres connection (docker-compose defaults).
DATABASE_URL=postgres://cruuze:cruuze@localhost:5433/cruuze?sslmode=disable

# Address the API listens on. Platforms that assign a port set PORT instead.
LISTEN_ADDR=:8080

# Public URL of the web app. Used for links in emails, cookies and CSRF checks.
APP_URL=http://localhost:5173

# SMTP (Mailpit in docker-compose). Leave SMTP_HOST empty to log emails to stdout instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cruuze <noreply@cruuze.local>
# Send through Resend's HTTP API instead of SMTP (for hosts that block SMTP).
RESEND_API_KEY=

# How long a notification stays unread before it is emailed. Negative turns
# notification emails off.
NOTIFICATION_EMAIL_DELAY=5m

# Operations. All optional; see "Build and deploy" in the README.
#   TRUST_PROXY=true          behind a proxy that sets X-Real-IP / X-Forwarded-For
#   CLOUDFLARE_WEB_ANALYTICS=true   let Cloudflare Web Analytics' script run (proxied through Cloudflare)
#   LOG_FORMAT=json           JSON log lines
#   METRICS_TOKEN=...         serve /metrics to requests with this bearer token
#   RATE_LIMIT_PER_MINUTE=1200
#   MAIL_DIR=/some/dir        write email to files instead of sending it (tests)

# Who administers the install besides the first person to sign in
# (comma-separated addresses). They get Settings > Instance.
INSTANCE_ADMINS=

# Let webhooks call http:// URLs and private addresses such as localhost.
# For development only; leave off in production.
WEBHOOK_ALLOW_PRIVATE=true

# Let importers (Settings → Import) read from private addresses, such as a
# Jira Server on your own network.
IMPORT_ALLOW_PRIVATE=true

# Encrypts the credentials the server keeps for imports (optional): a
# running import's own, so that it carries on after a restart, and the
# tokens of connected trackers. Make one with: openssl rand -base64 32
# Changing it later makes every connection ask to be connected again.
SECRETS_KEY=

# Connecting trackers for import without a token (optional; each needs
# SECRETS_KEY). Register an OAuth application with the tracker, with the
# redirect URI {APP_URL}/api/imports/connect/<github|jira|linear>/callback.
# See docs/import-connections.md.
IMPORT_GITHUB_CLIENT_ID=
IMPORT_GITHUB_CLIENT_SECRET=
IMPORT_ATLASSIAN_CLIENT_ID=
IMPORT_ATLASSIAN_CLIENT_SECRET=
IMPORT_LINEAR_CLIENT_ID=
IMPORT_LINEAR_CLIENT_SECRET=

# Google sign-in (optional). Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Attachments. With S3_BUCKET empty they are stored on local disk in STORAGE_DIR
# (relative to where the server runs). To use the MinIO from docker-compose
# (`docker compose --profile s3 up -d minio`):
#   S3_ENDPOINT=localhost:9000  S3_BUCKET=cruuze  S3_ACCESS_KEY=cruuze
#   S3_SECRET_KEY=cruuze-secret  S3_INSECURE=true
STORAGE_DIR=data/attachments
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_INSECURE=false
