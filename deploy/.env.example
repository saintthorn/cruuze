# Copy to .env and fill in. Only the first two are required.

# The name people will reach Cruuze at. Its DNS must point at this machine.
DOMAIN=cruuze.example.com

# Password for the database inside the stack. Pick something long and random:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Email --------------------------------------------------------------------
# Sign-in links, invites and notifications go by email, so one of these is
# needed before anyone can sign in. Without either, emails are written to the
# app's log (docker compose logs app), which is enough to try things out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or Resend's HTTP API, for machines whose provider blocks SMTP:
RESEND_API_KEY=
# MAIL_FROM=Cruuze <noreply@cruuze.example.com>

# --- Who runs it ---------------------------------------------------------------
# The first person to sign in becomes the instance admin and can restrict
# signups under Settings > Instance. Name more admins here, comma-separated.
INSTANCE_ADMINS=

# Importing from a Jira Server or GitHub Enterprise on your own network
# needs this; leave it off if this server is shared with people you don't
# know.
# IMPORT_ALLOW_PRIVATE=true

# --- Optional -------------------------------------------------------------------
# A released image instead of building from this checkout:
# CRUUZE_IMAGE=ghcr.io/<owner>/cruuze
# CRUUZE_VERSION=v1.0.0

# Google sign-in. Redirect URI: https://DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Serve Prometheus metrics at /metrics to requests with this bearer token.
METRICS_TOKEN=

# Keep attachments in S3-compatible storage instead of the appdata volume.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
