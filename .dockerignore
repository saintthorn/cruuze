# Keep the build context small and secrets out of the image.
.git
.github
.claude
.env
.env.*
!.env.example
**/node_modules
web/dist
web/e2e/.mail
web/e2e/.attachments
web/test-results
web/playwright-report
server/bin
server/data
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep
**/*.log
**/.DS_Store
deploy/backups
deploy/cloudflare/.wrangler
deploy/cloudflare/.dev.vars
deploy/cloudflare/.secrets
